{
  "name": "morbid-racers",
  "version": "1.17.0",
  "private": true,
  "description": "A neon anti-gravity arcade racer",
  "scripts": {
    "start": "node server.js",
    "check": "node tools/build.js --check && node --check game.js && node --check server.js && node --check sw.js && node --check pwa.js",
    "test": "node --test game.test.js",
    "release": "semantic-release",
    "build": "node tools/build.js",
    "smoke": "node tests/smoke.js",
    "typecheck": "tsc -p tsconfig.json",
    "visual": "node tests/visual.js",
    "lighthouse": "node tests/lighthouse.js"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "esbuild": "0.28.2",
    "pixelmatch": "5.3.0",
    "playwright": "1.65.0",
    "pngjs": "7.0.0",
    "semantic-release": "^24.2.9",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Jan-Frederic/Zero.git"
  }
